meta {
  name: Route inconnue (404)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/nimporte
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("une route inconnue renvoie aussi le format d'erreur JSON", function () {
    expect(res.body.status, "code dans le corps").to.equal(404);
    expect(res.body.error, "intitulé HTTP").to.equal("Not Found");
    expect(res.body.message, "message").to.equal("Ressource introuvable : /nimporte");
    expect(res.body.path, "chemin demandé").to.equal("/nimporte");
  });
}
