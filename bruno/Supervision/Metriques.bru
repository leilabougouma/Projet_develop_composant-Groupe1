meta {
  name: Métriques Prometheus
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/actuator/prometheus
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

assert {
  res.status: eq 200
}

tests {
  test("les métriques JVM et HTTP sont exposées", function () {
    expect(res.body, "corps de la réponse (texte Prometheus)").to.be.a("string");
    expect(res.body, "métrique mémoire JVM").to.include("jvm_memory_used_bytes");
    expect(res.body, "métrique des requêtes HTTP").to.include("http_server_requests_seconds");
  });
}

docs {
  Endpoint lu par Prometheus toutes les 5 s (voir `monitoring/prometheus.yml`).
}
