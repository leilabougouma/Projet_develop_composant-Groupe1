# =====================================================================
# Copier ce fichier en .env :   cp .env.example .env   (Windows : copy .env.example .env)
# Le fichier .env n'est PAS versionné (voir .gitignore).
# =====================================================================

# Fuseau horaire des conteneurs
TZ=Africa/Ouagadougou

# ---------- MySQL (base source)
MYSQL_ROOT_PASSWORD=root_change_moi
MYSQL_DATABASE=produits_source_db
MYSQL_USER=etl_user
MYSQL_PASSWORD=etl_change_moi
MYSQL_PORT=3306

# ---------- PostgreSQL (base cible)
POSTGRES_DB=produits_db
POSTGRES_USER=produits_user
POSTGRES_PASSWORD=produits_change_moi
PG_PORT=5432

# ---------- Ports des autres services (API, Prometheus, interface Hop)
API_PORT=8080
PROMETHEUS_PORT=9090
# Hop Web (interface de l'ETL dans le navigateur) : différent de API_PORT
HOP_WEB_PORT=8090
