          "name": "Créer - données invalides (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 400\", function () { pm.response.to.have.status(400); });",
                  "",
                  "const b = pm.response.json();",
                  "pm.test(\"format d'erreur standard\", function () {",
                  "  pm.expect(b.status).to.equal(400);",
                  "  pm.expect(b.error).to.equal(\"Bad Request\");",
                  "  pm.expect(b.message).to.equal(\"Données invalides\");",
                  "  pm.expect(b.path).to.equal(\"/api/v1/produits\");",
                  "  pm.expect(b.timestamp).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"chaque champ invalide est signalé avec un message\", function () {",
                  "  const m = {};",
                  "  b.details.forEach(d => m[d.champ] = d.message);",
                  "  pm.expect(Object.keys(m).sort()).to.eql([\"categorie\", \"nom\", \"prix\", \"quantite\"]);",
                  "  pm.expect(m.nom).to.equal(\"Le nom est obligatoire\");",
                  "  pm.expect(m.prix).to.equal(\"Le prix doit être positif ou nul\");",
                  "  pm.expect(m.quantite).to.equal(\"La quantité doit être positive ou nulle\");",
                  "  pm.expect(m.categorie).to.equal(\"La catégorie est obligatoire\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
