    {
      "name": "Supervision",
      "description": "Santé, métriques Prometheus et contrat OpenAPI.",
      "item": [
        {
          "name": "Santé de l'application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"l'état global et les composants sont UP\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.equal(\"UP\");",
                  "  pm.expect(b.components.db.status).to.equal(\"UP\");",
                  "  pm.expect(b.components.db.details.database).to.equal(\"PostgreSQL\");",
                  "  pm.expect(b.components.diskSpace.status).to.equal(\"UP\");",
                  "  pm.expect(b.components.ping.status).to.equal(\"UP\");",
                  "});"
                ]
              }
            }
