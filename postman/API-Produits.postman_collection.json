{
  "info": {
    "name": "API Produits",
    "description": "Collection Postman de l'API REST de produits (Exercice 1). Équivalent de la collection Bruno du dossier bruno/. Lancer le dossier « Produits » avec le Collection Runner, dans l'ordre : il crée puis supprime un produit (la base retrouve son état initial).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Produits",
      "description": "CRUD complet sur /api/v1/produits, à exécuter dans l'ordre.",
      "item": [
        {
          "name": "1. Lister les produits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"la réponse est une page\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.content).to.be.an(\"array\");",
                  "  pm.expect(b.page).to.equal(0);",
                  "  pm.expect(b.size).to.equal(20);",
                  "  pm.expect(b).to.include.all.keys(\"totalElements\", \"totalPages\");",
                  "  pm.expect(b.content.length).to.be.at.most(b.totalElements);",
                  "});",
                  "pm.test(\"les produits sont triés par id croissant\", function () {",
                  "  const ids = pm.response.json().content.map(p => p.id);",
                  "  pm.expect(ids).to.eql(ids.slice().sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produits"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Lister par catégorie (casse ignorée)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"tous les produits sont de la catégorie demandée\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.content).to.be.an(\"array\");",
                  "  b.content.forEach(p => pm.expect(p.categorie.toLowerCase()).to.equal(\"informatique\"));",
                  "  pm.expect(b.totalElements).to.be.at.least(b.content.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits?categorie=informatique&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produits"
              ],
              "query": [
                {
                  "key": "categorie",
                  "value": "informatique"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Créer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"produitId\", b.id);",
                  "pm.collectionVariables.set(\"dateCreation\", b.dateCreation);",
                  "pm.collectionVariables.set(\"nom\", b.nom);",
                  "pm.test(\"le produit est créé avec un id et une date de création\", function () {",
                  "  pm.expect(b.id).to.be.a(\"number\");",
                  "  pm.expect(b.dateCreation).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"les champs envoyés sont renvoyés tels quels\", function () {",
                  "  pm.expect(b.nom).to.equal(\"Clavier mécanique\");",
                  "  pm.expect(b.description).to.equal(\"Clavier AZERTY rétroéclairé\");",
                  "  pm.expect(b.prix).to.equal(59.9);",
                  "  pm.expect(b.quantite).to.equal(25);",
                  "  pm.expect(b.categorie).to.equal(\"Informatique\");",
                  "});",
                  "pm.test(\"l'en-tête Location pointe vers le nouveau produit\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/v1/produits/\" + b.id + \"$\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Clavier mécanique\",\n  \"description\": \"Clavier AZERTY rétroéclairé\",\n  \"prix\": 59.9,\n  \"quantite\": 25,\n  \"categorie\": \"Informatique\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "4. Consulter un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"le produit renvoyé est celui demandé et complet\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.id).to.equal(Number(pm.collectionVariables.get(\"produitId\")));",
                  "  pm.expect(b).to.have.all.keys([\"id\",\"nom\",\"description\",\"prix\",\"quantite\",\"categorie\",\"dateCreation\"]);",
                  "  pm.expect(b.prix).to.be.a(\"number\");",
                  "  pm.expect(b.quantite).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits/{{produitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produits",
                "{{produitId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "5. Modifier un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "const b = pm.response.json();",
                  "pm.test(\"tous les champs sont remplacés\", function () {",
                  "  pm.expect(b.nom).to.equal(\"Clavier mécanique (modifié)\");",
                  "  pm.expect(b.description).to.equal(\"Clavier QWERTY sans fil\");",
                  "  pm.expect(b.prix).to.equal(49.9);",
                  "  pm.expect(b.quantite).to.equal(10);",
                  "  pm.expect(b.categorie).to.equal(\"Informatique\");",
                  "});",
                  "pm.test(\"l'id et dateCreation ne changent pas\", function () {",
                  "  pm.expect(b.id).to.equal(Number(pm.collectionVariables.get(\"produitId\")));",
                  "  pm.expect(b.dateCreation).to.equal(pm.collectionVariables.get(\"dateCreation\"));",
                  "});",
                  "pm.collectionVariables.set(\"nom\", b.nom);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits/{{produitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produits",
                "{{produitId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Clavier mécanique (modifié)\",\n  \"description\": \"Clavier QWERTY sans fil\",\n  \"prix\": 49.9,\n  \"quantite\": 10,\n  \"categorie\": \"Informatique\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "6. Supprimer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "pm.test(\"la réponse confirme la suppression et rappelle le produit\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.message).to.equal(\"Produit \" + Number(pm.collectionVariables.get(\"produitId\")) + \" supprimé\");",
                  "  pm.expect(b.produit.id).to.equal(Number(pm.collectionVariables.get(\"produitId\")));",
                  "  pm.expect(b.produit).to.have.all.keys([\"id\",\"nom\",\"description\",\"prix\",\"quantite\",\"categorie\",\"dateCreation\"]);",
                  "  pm.expect(b.produit.nom).to.equal(pm.collectionVariables.get(\"nom\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits/{{produitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "produits",
                "{{produitId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "7. Vérifier la suppression (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 404\", function () { pm.response.to.have.status(404); });",
                  "",
                  "pm.test(\"message d'erreur explicite\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.equal(404);",
                  "  pm.expect(b.message).to.equal(\"Produit introuvable avec l'id \" + Number(pm.collectionVariables.get(\"produitId\")));",
                  "  pm.expect(b.path).to.equal(\"/api/v1/produits/\" + Number(pm.collectionVariables.get(\"produitId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/produits/{{produitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
