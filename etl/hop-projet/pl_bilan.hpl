<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_bilan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Compte les lignes lues (MySQL), chargées et rejetées (PostgreSQL) et les transmet au workflow</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/28 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/28 10:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Compter lignes source</from>
      <to>Regrouper les compteurs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compter lignes cible</from>
      <to>Regrouper les compteurs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Regrouper les compteurs</from>
      <to>Transmettre au workflow</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Compter lignes source</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mysql_source</connection>
    <sql>SELECT COUNT(*) AS nb_lues FROM produits_source</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Compter lignes cible</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres_cible</connection>
    <sql>SELECT (SELECT COUNT(*) FROM produits)        AS nb_produits,
       (SELECT COUNT(*) FROM produits_rejets) AS nb_rejets</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Regrouper les compteurs</name>
    <type>JoinRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <cache_size>500</cache_size>
    <main/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue/>
        <function>=</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Transmettre au workflow</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>nb_lues</field_name>
        <variable_name>NB_LUES</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>nb_produits</field_name>
        <variable_name>NB_PRODUITS</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>nb_rejets</field_name>
        <variable_name>NB_REJETS</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <use_formatting>N</use_formatting>
    <attributes/>
    <GUI>
      <xloc>528</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
