<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_produits</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Extraction MySQL, contrôle qualité, normalisation des catégories et chargement PostgreSQL</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/28 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/28 10:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>ETL produits : MySQL (produits_source) -> PostgreSQL (produits + produits_rejets)
1. Normalisation : trim du nom ; catégorie en minuscules, sans espaces autour ni accents (ÉLECTRONIQUE -> electronique)
2. Recherche de la catégorie officielle dans etl/referentiel/categories.csv (catégorie inconnue = rejet)
3. Contrôle : nom, prix, catégorie obligatoires ; prix >= 0 ; quantité >= 0. Le champ motif liste toutes les erreurs.
4. Lignes valides : insertion ou mise à jour (clé fonctionnelle nom + catégorie, donc pas de doublon)
5. Lignes invalides : table produits_rejets (vidée à chaque exécution pour refléter le dernier passage)</note>
      <xloc>80</xloc>
      <yloc>336</yloc>
      <width>700</width>
      <heigth>110</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Lire produits_source</from>
      <to>Normaliser nom et catégorie</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normaliser nom et catégorie</from>
      <to>Chercher catégorie officielle</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lire categories.csv</from>
      <to>Chercher catégorie officielle</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Chercher catégorie officielle</from>
      <to>Contrôler les valeurs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Contrôler les valeurs</from>
      <to>Ligne valide ?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ligne valide ?</from>
      <to>Préparer produit</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ligne valide ?</from>
      <to>Préparer rejet</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Préparer produit</from>
      <to>Insérer / mettre à jour produits</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Préparer rejet</from>
      <to>Journaliser rejet</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Journaliser rejet</from>
      <to>Écrire produits_rejets</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Lire produits_source</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mysql_source</connection>
    <sql>SELECT id, nom, description, prix, quantite, categorie
FROM produits_source
ORDER BY id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Normaliser nom et catégorie</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// nom : suppression des espaces au début et à la fin
if (nom != null) {
  nom = String(nom).trim();
}

// categorie_cle : trim + minuscules + suppression des accents
// ex. ' ÉLECTRONIQUE ' -> 'electronique', 'Vêtements' -> 'vetements'
var categorie_cle = null;
if (categorie != null) {
  var texte = String(categorie).trim().toLowerCase();
  var decompose = String(java.text.Normalizer.normalize(texte, java.text.Normalizer.Form.NFD));
  categorie_cle = decompose.replace(/[̀-ͯ]/g, "");
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>nom</name>
        <rename>nom</rename>
        <type>String</type>
        <length>150</length>
        <precision>-1</precision>
        <replace>Y</replace>
      </field>
      <field>
        <name>categorie_cle</name>
        <rename>categorie_cle</rename>
        <type>String</type>
        <length>100</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
