    <filename>${CATEGORIES_CSV}</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>variante</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>100</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>categorie_officielle</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>100</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>48</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Chercher catégorie officielle</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Lire categories.csv</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>N</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>categorie_cle</name>
        <field>variante</field>
      </key>
      <value>
        <name>categorie_officielle</name>
        <rename>categorie_officielle</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Contrôler les valeurs</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Règles de gestion : nom, prix, categorie obligatoires ; prix >= 0 ; quantite >= 0.
// motif = null si la ligne est valide, sinon la liste de toutes les erreurs trouvées.
var erreurs = [];

if (nom == null || String(nom) == "") {
  erreurs.push("nom manquant");
}

if (prix == null) {
  erreurs.push("prix manquant");
} else if (Number(prix) &lt; 0) {
  erreurs.push("prix négatif");
}

if (quantite == null) {
  erreurs.push("quantité manquante");
} else if (Number(quantite) &lt; 0) {
  erreurs.push("quantité négative");
}

if (categorie_cle == null || String(categorie_cle) == "") {
  erreurs.push("catégorie manquante");
} else if (categorie_officielle == null) {
  erreurs.push("catégorie inconnue (" + categorie_cle + ")");
}

var motif = (erreurs.length == 0) ? null : erreurs.join(", ");
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>motif</name>
        <rename>motif</rename>
        <type>String</type>
        <length>255</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>656</xloc>
      <yloc>160</yloc>
    </GUI>
