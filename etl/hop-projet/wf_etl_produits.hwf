<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_etl_produits</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orchestration de l'ETL produits : connexions, chargement, bilan et journalisation</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/28 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/28 10:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Vérifier les connexions</name>
      <description/>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <connections>
        <connection>
          <name>mysql_source</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>postgres_cible</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <parallel>N</parallel>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>pl_produits</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pl_produits.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>pl_bilan</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pl_bilan.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Journal succès</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>==================== ETL produits : SUCCÈS ====================
Lignes lues dans MySQL (produits_source)    : ${NB_LUES}
Produits dans PostgreSQL (produits)         : ${NB_PRODUITS}
Lignes rejetées (produits_rejets)           : ${NB_REJETS}
================================================================</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>Bilan ETL</logsubject>
      <parallel>N</parallel>
      <xloc>784</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Succès</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>960</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Journal échec</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>==================== ETL produits : ÉCHEC ====================
Le workflow s'est arrêté sur une erreur : voir les messages ci-dessus.
Vérifier que les conteneurs mysql et postgres sont démarrés et que
les variables de l'environnement Hop (hôtes, ports, mots de passe) sont correctes.
===============================================================</logmessage>
      <loglevel>Error</loglevel>
      <logsubject>Bilan ETL</logsubject>
      <parallel>N</parallel>
      <xloc>432</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Échec</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>ETL produits en échec</message>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Vérifier les connexions</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Vérifier les connexions</from>
      <to>pl_produits</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pl_produits</from>
      <to>pl_bilan</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pl_bilan</from>
      <to>Journal succès</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Journal succès</from>
      <to>Succès</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Vérifier les connexions</from>
      <to>Journal échec</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pl_produits</from>
      <to>Journal échec</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pl_bilan</from>
      <to>Journal échec</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Journal échec</from>
      <to>Échec</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>
